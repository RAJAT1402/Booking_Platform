DATABASE_URL="postgresql://postgres:postgres@localhost:5432/booking_platform?schema=public"

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Where to send the browser after a successful Google login.
# Tokens are appended as ?accessToken=...&refreshToken=...
FRONTEND_URL=http://localhost:5173/auth/callback

# JWT
JWT_SECRET=replace-me-with-a-long-random-string
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Redis (used later by seat-lock service, not by auth)
REDIS_URL=redis://localhost:6379

# Booking confirmation emails (SMTP provider credentials)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="showpanda.in@gmail.com"
SMTP_PASSWORD="bume lrhi ptdj axzu"
SMTP_FROM="showpanda.in@gmail.com"

# Use a separate random secret (at least 32 bytes); keep stable to verify issued tickets.
BOOKING_QR_SECRET=
BOOKING_TIMEZONE=Asia/Kolkata
